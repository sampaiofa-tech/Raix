# Valores de fallback para compilacao em ambientes sem .env (CI/CD).
# O plugin Secrets Gradle (com.google.android.libraries.mapsplatform.secrets-gradle-plugin)
# le este arquivo como defaultPropertiesFileName quando .env nao existe.
# Cada propriedade aqui vira um buildConfigField no BuildConfig.java gerado.

# Firebase Web API Keys (valores dummy -- nao concedem acesso a producao)
FIREBASE_ANDROID_WEB_API_KEY=dummy
FIREBASE_DESKTOP_WEB_API_KEY=dummy
FIREBASE_WEB_API_KEY=dummy

# Gemini API Key (placeholder -- injetada via Secret Manager em producao)
GEMINI_API_KEY=dummy
